<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The SDK generates manifest.json and PluginBuildInfo from these -->
    <PluginId>wiz</PluginId>
    <PluginDisplayName>WiZ</PluginDisplayName>
    <Version>0.1.0</Version>
    <Authors>DMX Core</Authors>

    <!-- Plugin registry (nuget.org) package metadata. DMXCore.Plugin.* is the
         reserved first-party prefix; the package is produced by `dotnet pack`
         via the DMXCore.PluginSdk pack targets. -->
    <PackageId>DMXCore.Plugin.WiZ</PackageId>
    <Description>WiZ output for the DMX Core 100 lighting controller: drives WiZ (Signify) WiFi color and tunable-white bulbs from DMX channel data over the WiZ local UDP protocol, no cloud account required.</Description>
    <PackageProjectUrl>https://docs.dmxcore.com/dmx-core-100</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Embedded icon (not iconUrl) is a nuget.org reserved-prefix review
         criterion; icon.png is the same 128x128 logo the SDK packages ship. -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>wiz;philips;lan;smart-lighting</PackageTags>
    <!-- Everything this plugin uses (plugin fixture profiles, generated
         manifest, destination discovery) is SDK contract 1.6, so declare
         that floor explicitly instead of inheriting whatever newer SDK the
         floating 1.* reference happens to resolve to at build time. -->
    <PluginMinSdkVersion>1.6</PluginMinSdkVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DMXCore100.WiZ.Tests" />
    <InternalsVisibleTo Include="DMXCore100.WiZ.DevHost" />
  </ItemGroup>

  <ItemGroup>
    <!-- ExcludeAssets="runtime": the DMX Core 100 host provides the SDK (and
         its dependencies) at runtime and always resolves them to its own
         copies, so they must not be shipped inside the .dmxplugin. -->
    <PackageReference Include="DMXCore.PluginSdk" Version="1.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
